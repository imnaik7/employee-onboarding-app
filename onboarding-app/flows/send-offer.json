olid #E2E8F0\">@{formatDateTime(triggerOutputs()?['body/StartDate'],'dddd, dd MMMM yyyy')}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Reporting to</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{triggerOutputs()?['body/HiringManager']}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Location</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{triggerOutputs()?['body/WorkLocation']}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Team</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{triggerOutputs()?['body/Department']}</td></tr></table><p style=\"margin:0 0 6px\"><b>Before day one</b></p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:6px 0;width:28px;vertical-align:top;font-size:16px\">&#128196;</td><td style=\"padding:6px 0;color:#0F172A;font-size:14px\">Keep your ID proof, PAN and bank details handy &mdash; HR will reach out to collect them.</td></tr><tr><td style=\"padding:6px 0;width:28px;vertical-align:top;font-size:16px\">&#128187;</td><td style=\"padding:6px 0;color:#0F172A;font-size:14px\">Your laptop and company account will be ready before you join.</td></tr><tr><td style=\"padding:6px 0;width:28px;vertical-align:top;font-size:16px\">&#129309;</td><td style=\"padding:6px 0;color:#0F172A;font-size:14px\">You will be paired with an onboarding buddy in your first week.</td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 8px\"><tr><td style=\"border-radius:10px;background:#4F46E5;background-image:linear-gradient(135deg,#4F46E5,#7C3AED)\"><a href=\"https://imnaik.sharepoint.com/sites/My-SP-Dev@{body('Save_signed_letter')?['Path']}\" style=\"display:inline-block;padding:13px 28px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">View your signed offer letter &rarr;</a></td></tr></table><p style=\"margin:16px 0 0;color:#64748B;font-size:12px;line-height:1.6\">A copy of your signed offer letter is stored securely. We can't wait to meet you!</p></td></tr><tr><td style=\"background:#F8FAFC;padding:20px 36px;border-top:1px solid #E2E8F0;color:#64748B;font-size:12px;line-height:1.6\"><b style=\"color:#0F172A\">Power Platform AI Solution</b> &middot; Talent &amp; People Team<br/>This is an automated message from our onboarding system.</td></tr></table></td></tr></table></body></html>",
                    "emailMessage/Importance": "Normal"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "Declined": {
            "case": "declined",
            "actions": {
              "Get_declined_letter": {
                "runAfter": {},
