2A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{triggerOutputs()?['body/Position']}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Team</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{triggerOutputs()?['body/Department']}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Location</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{triggerOutputs()?['body/WorkLocation']}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Proposed joining date</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">@{formatDateTime(triggerOutputs()?['body/StartDate'],'dddd, dd MMMM yyyy')}</td></tr><tr><td style=\"padding:10px 16px;color:#64748B;font-size:13px;border-bottom:1px solid #E2E8F0;width:40%\">Annual CTC</td><td style=\"padding:10px 16px;color:#0F172A;font-size:14px;font-weight:600;border-bottom:1px solid #E2E8F0\">INR @{formatNumber(float(coalesce(triggerOutputs()?['body/Salary'],0)),'N0','en-IN')}</td></tr></table><p style=\"margin:0 0 6px\"><b>Next steps</b></p><ol style=\"margin:0;padding-left:20px;color:#0F172A\"><li>Open the DocuSign email titled <i>&ldquo;Your offer letter from Power Platform AI Solution&rdquo;</i>.</li><li>Review the letter and salary breakup.</li><li>Sign to accept &mdash; it takes under a minute.</li></ol><p style=\"margin:16px 0 0;color:#64748B;font-size:12px;line-height:1.6\">Please sign within 7 days. Questions? Simply reply to this email and our Talent team will help.</p></td></tr><tr><td style=\"background:#F8FAFC;padding:20px 36px;border-top:1px solid #E2E8F0;color:#64748B;font-size:12px;line-height:1.6\"><b style=\"color:#0F172A\">Power Platform AI Solution</b> &middot; Talent &amp; People Team<br/>This is an automated message from our onboarding system.</td></tr></table></td></tr></table></body></html>",
            "emailMessage/Importance": "Normal"
